---
/**
 * Surfaces the blog posts that reference this page.
 *
 * Why this exists: the blog linked *out* to service and area pages, but nothing
 * linked *back in* — measured across the built site, service and area pages sent
 * exactly zero links to blog posts. Every guide was reachable only from the blog
 * index, so almost no internal authority reached them.
 *
 * The mapping is derived, not hand-maintained: each post already links to the
 * services and areas it discusses, so we invert those links.
 */
import { getCollection } from "astro:content";

interface Props {
  /** Path of the current page, e.g. "/services/hardscaping/" or "/areas/kanata/". */
  path: string;
  heading?: string;
  max?: number;
}

const { path, heading = "Guides worth reading", max = 3 } = Astro.props;

const normalize = (u: string) => {
  const s = (u || "").split("#")[0].split("?")[0];
  if (!s.startsWith("/")) return "";
  return s.endsWith("/") ? s : `${s}/`;
};

const here = normalize(path);

const all = (await getCollection("blog"));

const matches = all
  .filter((p) =>
    [...(p.body ?? "").matchAll(/\]\(([^)]+)\)/g)].some((m) => normalize(m[1]) === here),
  )
  .sort((a, b) => String(b.data.pubDate ?? b.data.date ?? "").localeCompare(String(a.data.pubDate ?? a.data.date ?? "")))
  .slice(0, max);
---

{matches.length > 0 && (
  <section class="bg-stone-50 py-16">
    <div class="mx-auto max-w-6xl px-4">
      <h2 class="font-serif text-3xl text-stone-900">{heading}</h2>
      <p class="mt-2 text-stone-600">
        Practical answers from the team, no sales pitch.
      </p>
      <div class="mt-8 grid gap-6 md:grid-cols-3">
        {matches.map((p) => (
          <a
            href={`/blog/${p.id.replace(/\.md$/, "")}/`}
            class="group block rounded-lg border border-stone-200 bg-white p-6 no-underline transition hover:border-stone-400 hover:shadow-md"
          >
            <span class="text-xs font-semibold uppercase tracking-wider text-stone-500">
              {p.data.category ?? "Guide"}
            </span>
            <h3 class="mt-2 font-serif text-lg leading-snug text-stone-900">
              {p.data.title}
            </h3>
            <p class="mt-3 text-sm leading-relaxed text-stone-600">
              {p.data.description ?? p.data.excerpt ?? ""}
            </p>
            <span class="mt-4 inline-block text-sm font-semibold text-stone-900">
              Read the guide &rarr;
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>
)}
