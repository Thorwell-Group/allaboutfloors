---
// Screening step between the /free-estimate/ survey and the booking calendars:
// the visitor picks an in-home estimate or a showroom appointment.
// Intentionally NO Meta Pixel on this page: Lead fires on arrival at whichever
// calendar the visitor lands on, Schedule fires on booking (unchanged).
import BaseLayout from '@layouts/BaseLayout.astro';

const options = [
  {
    href: '/book-in-home/',
    label: 'In-Home Appointment',
    desc: 'We come to you with samples and take measurements. Free, no obligation.',
  },
  {
    href: '/book-in-store/?screen=1',
    label: 'Showroom Appointment',
    desc: 'Visit our Vancouver showroom and see hundreds of options side by side.',
  },
];
---

<BaseLayout
  title="Choose Your Appointment | All About Floors NW"
  description="Pick an in-home estimate or a showroom appointment with All About Floors NW."
  bare={true}
  noIndex={true}
>
  <!-- Minimal brand bar (locked funnel) -->
  <div class="bg-brand-navy py-3 border-b border-white/5">
    <div class="max-w-7xl mx-auto px-4 flex items-center justify-center">
      <img
        src="/images/all-about-floors-nw-logo.webp"
        alt="All About Floors NW"
        class="h-10 w-auto max-w-[200px] object-contain"
        width="200"
        height="40"
        loading="eager"
      />
    </div>
  </div>

  <section class="bg-brand-navy text-white relative overflow-hidden min-h-[80vh]">
    <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 20% 30%, #C8A55B 0%, transparent 50%), radial-gradient(circle at 80% 70%, #C8A55B 0%, transparent 50%);"></div>
    <div class="max-w-3xl mx-auto px-4 pt-8 pb-14 md:pt-14 md:pb-20 relative z-10">
      <div class="text-center mb-8">
        <span class="inline-block bg-brand-gold/20 border border-brand-gold/40 text-brand-gold-light text-[11px] md:text-sm font-semibold uppercase tracking-widest px-3 py-1 rounded-full mb-3">
          Step 2 of 3
        </span>
        <h1 class="font-heading font-bold text-2xl md:text-4xl leading-tight">
          How would you like to meet?
        </h1>
        <p class="text-gray-300 mt-2 md:text-lg">Pick the appointment that works best for you.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {options.map(o => (
          <a
            href={o.href}
            class="block bg-white text-brand-navy rounded-2xl shadow-2xl border-2 border-transparent hover:border-brand-gold p-6 md:p-8 text-center transition-colors"
          >
            <div class="font-heading font-bold text-xl md:text-2xl">{o.label}</div>
            <p class="text-sm text-gray-500 mt-2 leading-relaxed">{o.desc}</p>
            <span class="btn-primary mt-5 w-full justify-center">Book {o.label}</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
