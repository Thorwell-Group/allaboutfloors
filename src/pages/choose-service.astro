---
// Screening step between the /free-estimate/ survey and the booking calendars.
// Hardwood + refinishing → in-home estimate. Everything else → showroom visit.
// Intentionally NO Meta Pixel on this page: Lead fires on arrival at whichever
// calendar the visitor lands on, Schedule fires on booking (unchanged).
import BaseLayout from '@layouts/BaseLayout.astro';

const inHome = [
  { key: 'hardwood', label: 'Hardwood Flooring', desc: 'New solid or engineered hardwood' },
  { key: 'refinishing', label: 'Hardwood Refinishing', desc: 'Sand, stain & refinish existing floors' },
];

const showroom = [
  { key: 'lvp', label: 'Luxury Vinyl Plank (LVP)' },
  { key: 'laminate', label: 'Laminate' },
  { key: 'carpet', label: 'Carpet' },
  { key: 'tile', label: 'Tile' },
  { key: 'vinyl', label: 'Sheet Vinyl' },
  { key: 'countertops', label: 'Countertops' },
  { key: 'commercial', label: 'Commercial Flooring' },
  { key: 'other', label: 'Not Sure / Something Else' },
];
---

<BaseLayout
  title="What Are You Looking For? | All About Floors NW"
  description="Tell us what you're shopping for so we can book the right appointment."
  bare={true}
  noIndex={true}
>
  <!-- Minimal brand bar (locked funnel) -->
  <div class="bg-brand-navy py-3 border-b border-white/5">
    <div class="max-w-7xl mx-auto px-4 flex items-center justify-center">
      <img
        src="/images/all-about-floors-nw-logo.webp"
        alt="All About Floors NW"
        class="h-10 w-auto max-w-[200px] object-contain"
        width="200"
        height="40"
        loading="eager"
      />
    </div>
  </div>

  <section class="bg-brand-navy text-white relative overflow-hidden min-h-[80vh]">
    <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 20% 30%, #C8A55B 0%, transparent 50%), radial-gradient(circle at 80% 70%, #C8A55B 0%, transparent 50%);"></div>
    <div class="max-w-3xl mx-auto px-4 pt-8 pb-14 md:pt-14 md:pb-20 relative z-10">
      <div class="text-center mb-8">
        <span class="inline-block bg-brand-gold/20 border border-brand-gold/40 text-brand-gold-light text-[11px] md:text-sm font-semibold uppercase tracking-widest px-3 py-1 rounded-full mb-3">
          Step 2 of 3
        </span>
        <h1 class="font-heading font-bold text-2xl md:text-4xl leading-tight">
          What are you shopping for?
        </h1>
        <p class="text-gray-300 mt-2 md:text-lg">Pick one so we can book the right appointment for you.</p>
      </div>

      <div class="bg-white text-brand-navy rounded-2xl shadow-2xl p-5 md:p-8">
        <h2 class="font-heading font-semibold text-lg mb-1">Free in-home estimate</h2>
        <p class="text-sm text-gray-500 mb-4">We come to you with samples and take measurements.</p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-8">
          {inHome.map(o => (
            <a
              href="/book-in-home/"
              class="screen-option block rounded-xl border-2 border-brand-gold/40 hover:border-brand-gold hover:bg-brand-gold/5 p-4 transition-colors"
            >
              <div class="font-heading font-bold text-lg">{o.label}</div>
              <div class="text-sm text-gray-500 mt-0.5">{o.desc}</div>
            </a>
          ))}
        </div>

        <h2 class="font-heading font-semibold text-lg mb-1">Showroom visit</h2>
        <p class="text-sm text-gray-500 mb-4">
          For every product outside hardwood and refinishing, we start in the showroom. Styles, colors, thicknesses
          and pricing vary a lot between these products, so it's far easier to see and feel them side by side than
          to bring a handful of samples to your home.
        </p>
        <div class="grid grid-cols-2 gap-3">
          {showroom.map(o => (
            <a
              href="/book-in-store/?screen=1"
              class="screen-option block rounded-xl border-2 border-gray-200 hover:border-brand-navy hover:bg-brand-light p-3 md:p-4 text-center font-semibold transition-colors"
            >
              {o.label}
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

</BaseLayout>
