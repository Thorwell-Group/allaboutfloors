---
/**
 * /free-estimate — paid-traffic funnel landing page (FB / Meta).
 * Layout follows the TFPros /book funnel (house funnel template):
 * promo strip -> headline + FORM (in view on land) -> weekly-openings timer ->
 * real reviews -> facts -> what happens next -> financing -> quick answers -> final CTA.
 * Only claims that appear on the main site (rating 4.8 per homepage, 25+ years,
 * 5,000+ projects, WA licensed & insured, 0% APR financing per /financing/).
 * No discounts — the main site runs none.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import { company } from '@data/company';
import { reviews } from '@data/reviews';

const topReviews = reviews.slice(0, 6);
const TZ = 'America/Los_Angeles';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: 'Book Your Free Flooring Estimate Appointment',
  url: 'https://www.allaboutfloorsnw.com/free-estimate/',
  description: 'Book a free flooring estimate appointment with All About Floors NW in Vancouver, WA. Pick in-home or showroom. No pressure, no obligation.',
};

const strip = [
  'Free in-home estimates across Clark County',
  `Locally owned since ${company.founded}`,
  `${company.rating} ★ on Google`,
  'WA licensed & insured',
  'Showroom in Vancouver, WA',
  '0% APR financing for qualified customers',
];

const faqs = [
  { q: 'Is the estimate free?', a: 'Yes. Free in-home estimates throughout Clark County, WA and the Portland metro. No pressure, no obligation.' },
  { q: 'What areas do you serve?', a: 'All of Clark County, WA — Vancouver, Battle Ground, Camas, Washougal, Ridgefield, La Center, Brush Prairie, Salmon Creek and Hazel Dell — plus Portland and Gresham, OR.' },
  { q: 'Can I see samples before committing?', a: `Absolutely. Our showroom at ${company.address.full} has hundreds of samples on display, or we can bring samples to your home during your free estimate.` },
  { q: 'What warranty do you provide?', a: 'An industry-leading installation warranty on all flooring projects. Product warranties vary by manufacturer, and we walk you through them during your estimate.' },
];
---

<BaseLayout
  title="Book Your Free Flooring Estimate | All About Floors NW, Vancouver WA"
  description="Free flooring estimate in Vancouver, WA. Choose in-home or showroom appointment. No pressure, no obligation."
  schema={schema}
  bare={true}
>
  <Fragment slot="head">
    <!-- Warm the GHL connection so the survey iframe paints fast -->
    <link rel="preconnect" href="https://api.leadconnectorhq.com" crossorigin />
    <link rel="preconnect" href="https://link.msgsndr.com" crossorigin />
    <link rel="dns-prefetch" href="https://api.leadconnectorhq.com" />
    <link rel="preload" as="script" href="https://link.msgsndr.com/js/form_embed.js" />
    <!-- Meta Pixel Code -->
    <script is:inline>
      !function(f,b,e,v,n,t,s)
      {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
      n.callMethod.apply(n,arguments):n.queue.push(arguments)};
      if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
      n.queue=[];t=b.createElement(e);t.async=!0;
      t.src=v;s=b.getElementsByTagName(e)[0];
      s.parentNode.insertBefore(t,s)}(window, document,'script',
      'https://connect.facebook.net/en_US/fbevents.js');
      fbq('init', '1975197519985839');
      fbq('track', 'PageView');
    </script>
    <noscript><img height="1" width="1" style="display:none"
      src="https://www.facebook.com/tr?id=1975197519985839&ev=PageView&noscript=1"
    /></noscript>
    <!-- End Meta Pixel Code -->
    <!-- Ad attribution capture (tw_attrib) is injected site-wide by BaseLayout. -->
  </Fragment>

  {/* PROMO STRIP — scrolling, true facts only */}
  <div class="fe-strip bg-brand-gold text-white overflow-hidden" aria-label="Why All About Floors NW">
    <div class="fe-strip-track flex whitespace-nowrap py-2 text-[0.8rem] font-semibold tracking-wide">
      {Array.from({ length: 2 }).map(() => (
        <div class="flex shrink-0 items-center">
          {strip.map((msg) => (
            <span class="flex items-center px-5">
              <span>{msg}</span>
              <span class="ml-10 text-white/50" aria-hidden="true">·</span>
            </span>
          ))}
        </div>
      ))}
    </div>
  </div>

  {/* Minimal brand bar (no nav — funnel is locked) */}
  <div class="bg-brand-navy py-2.5 border-b border-white/5">
    <div class="max-w-6xl mx-auto px-5 flex items-center justify-center">
      <img
        src="/images/all-about-floors-nw-logo.webp"
        alt="All About Floors NW"
        class="h-9 w-auto max-w-[180px] object-contain"
        width="180"
        height="36"
        loading="eager"
      />
    </div>
  </div>

  {/* HERO — headline + subhead, then the form (in view on land, mobile + desktop) */}
  <section class="bg-brand-navy text-white">
    <div class="mx-auto w-full max-w-6xl px-5 pt-4 pb-12 lg:pt-14 lg:pb-20">
      <div class="grid lg:grid-cols-[1fr_480px] gap-5 lg:gap-14 items-start">
        <div class="lg:pt-6">
          <h1 class="font-heading font-bold leading-[1.1] text-[1.6rem] sm:text-4xl lg:text-5xl text-white">
            We'd love to talk to you about <span class="text-brand-gold-light">your project.</span>
          </h1>
          <p class="mt-2 lg:mt-5 text-[0.95rem] sm:text-lg text-white/80 leading-snug lg:leading-relaxed max-w-xl">
            Submit your info and someone will reach out to you regarding your project and your vision.
          </p>
          <ul class="hidden lg:grid mt-7 gap-2.5 list-none p-0">
            {[
              'Free in-home or showroom estimate',
              'Transparent pricing — no hidden fees',
              'WA licensed & insured, locally owned',
              `Serving Clark County since ${company.founded}`,
            ].map((v) => (
              <li class="flex items-center gap-2.5 text-base text-white/90">
                <svg class="w-5 h-5 flex-none text-brand-gold-light" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                <span>{v}</span>
              </li>
            ))}
          </ul>
        </div>

        <div id="book" class="scroll-mt-4">
          <div class="rounded-2xl bg-white ring-1 ring-brand-gold/30 shadow-xl overflow-hidden">
            <div class="bg-gradient-to-r from-brand-gold to-[#a30000] px-5 py-2.5">
              <div class="text-[0.65rem] uppercase tracking-[0.2em] font-bold text-white/85">Free · No obligation</div>
              <div class="font-heading text-lg font-bold text-white leading-tight">Tell us about your project</div>
            </div>
            <iframe
              src="https://api.leadconnectorhq.com/widget/survey/28BfbXbvFgh5ZaAV6B7f"
              style="border:none;width:100%;height:560px;display:block;background:white;margin:0;"
              scrolling="no"
              id="28BfbXbvFgh5ZaAV6B7f"
              title="Free Flooring Estimate Survey"
              loading="eager"
            ></iframe>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* WEEKLY OPENINGS — resets every Sunday at midnight, Vancouver WA (Pacific) time */}
  <section class="bg-gradient-to-r from-[#2a0000] via-brand-dark to-[#2a0000] text-white border-y border-brand-gold/30">
    <div class="mx-auto max-w-6xl px-5 py-10 lg:py-14 flex flex-col lg:flex-row items-center justify-between gap-7">
      <div class="text-center lg:text-left">
        <span class="inline-flex items-center gap-2 rounded-full bg-white/10 ring-1 ring-white/20 px-3 py-1 text-[0.65rem] uppercase tracking-[0.2em] font-bold">
          <span class="h-1.5 w-1.5 rounded-full bg-brand-gold-light animate-pulse"></span>
          Limited openings
        </span>
        <h2 class="mt-3 font-heading text-3xl sm:text-4xl font-bold leading-tight">This week's estimate openings</h2>
        <p class="mt-2 text-white/75">The schedule for this week closes when the timer hits zero.</p>
      </div>
      <div class="flex gap-2.5 sm:gap-3" data-countdown data-tz={TZ} role="timer" aria-label="Time left to book this week">
        {[['d', 'Days'], ['h', 'Hrs'], ['m', 'Min'], ['s', 'Sec']].map(([k, label]) => (
          <div class="cd-seg">
            <span data-cd={k}>--</span>
            <small>{label}</small>
          </div>
        ))}
      </div>
    </div>
    <div class="pb-10 text-center">
      <a href="#book" class="inline-flex items-center gap-2 rounded-full bg-brand-gold hover:bg-brand-gold-light px-7 py-3.5 font-bold text-sm text-white">
        Grab a spot this week
        <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
      </a>
    </div>
  </section>

  {/* SOCIAL PROOF — real Google reviews, no invented counts */}
  <section class="bg-black text-white py-14 lg:py-20">
    <div class="mx-auto max-w-6xl px-5">
      <div class="text-center max-w-2xl mx-auto">
        <div class="text-yellow-400 tracking-[0.2em] text-lg" aria-hidden="true">★★★★★</div>
        <h2 class="mt-2 font-heading text-2xl sm:text-3xl lg:text-4xl font-bold leading-tight">What Clark County homeowners say.</h2>
        <p class="mt-2 text-sm text-gray-400">Real Google reviews · {company.rating} ★ on Google</p>
      </div>
      <ul class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3 list-none p-0">
        {topReviews.map((r) => (
          <li class="rounded-2xl bg-white/5 ring-1 ring-white/10 p-6">
            <div class="flex items-center gap-3">
              <span class="grid h-10 w-10 place-items-center rounded-full bg-brand-gold text-white font-bold text-sm" aria-hidden="true">{r.name.charAt(0).toUpperCase()}</span>
              <div class="leading-tight">
                <div class="font-semibold text-sm">{r.name}</div>
                <div class="text-[11px] text-white/60">{r.service}</div>
              </div>
              <div class="ml-auto text-yellow-400 tracking-[2px] text-sm" aria-label={`${r.rating} out of 5 stars`}>{'★'.repeat(r.rating)}</div>
            </div>
            <p class="mt-4 text-sm text-white/85 leading-relaxed">"{r.text}"</p>
          </li>
        ))}
      </ul>
      <div class="mt-8 text-center">
        <a href="#book" class="inline-flex items-center gap-2 rounded-full bg-brand-gold hover:bg-brand-gold-light px-6 py-3 font-semibold text-white text-sm">Tell us about your project</a>
      </div>
    </div>
  </section>

  {/* FACTS BAND — only what the main site states */}
  <section class="bg-brand-navy text-white py-12 lg:py-16">
    <ul class="mx-auto max-w-6xl px-5 grid grid-cols-2 lg:grid-cols-4 gap-y-8 gap-x-6 text-center list-none p-0">
      {[
        { v: company.yearsExperience, label: 'Years in Vancouver' },
        { v: '5,000+', label: 'Projects completed' },
        { v: `${company.rating} ★`, label: 'On Google' },
        { v: 'Licensed', label: 'WA licensed & insured' },
      ].map((s) => (
        <li>
          <div class="font-heading text-4xl sm:text-5xl font-bold text-brand-gold-light leading-none">{s.v}</div>
          <div class="mt-3 text-[11px] uppercase tracking-[0.22em] text-gray-400 font-semibold">{s.label}</div>
        </li>
      ))}
    </ul>
  </section>

  {/* WHAT HAPPENS NEXT */}
  <section class="bg-brand-dark text-white py-14 lg:py-20">
    <div class="mx-auto max-w-5xl px-5">
      <h2 class="text-center font-heading text-2xl sm:text-3xl lg:text-4xl font-bold leading-tight">What happens next.</h2>
      <ol class="mt-10 grid gap-5 md:grid-cols-3 list-none p-0">
        {[
          { n: '01', t: 'We reach out', b: 'Someone from our team contacts you to talk through your project and your vision.' },
          { n: '02', t: 'Free estimate', b: 'In your home with samples, or at our Vancouver, WA showroom. Zero pressure.' },
          { n: '03', t: 'Transparent quote', b: 'Materials, labor, underlayment and disposal included. No hidden fees — what we quote is what you pay.' },
        ].map((s) => (
          <li class="rounded-2xl bg-brand-navy ring-1 ring-brand-gold/25 p-7">
            <div class="font-heading text-3xl font-bold text-brand-gold-light">{s.n}</div>
            <h3 class="mt-2 font-heading text-lg font-bold">{s.t}</h3>
            <p class="mt-2 text-sm text-white/75 leading-relaxed">{s.b}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  {/* FINANCING — advertised on the main site (/financing/) */}
  <section class="bg-gradient-to-r from-brand-gold to-[#a30000] text-white">
    <div class="mx-auto max-w-4xl px-5 py-12 lg:py-14 text-center">
      <div class="text-[0.7rem] uppercase tracking-[0.2em] font-bold text-white/85">Special financing</div>
      <h2 class="mt-2 font-heading text-2xl sm:text-3xl lg:text-4xl font-bold leading-tight">0% APR for 12–24 months</h2>
      <p class="mt-3 text-white/90 max-w-2xl mx-auto">For qualified customers. Financing is discussed and applied for during your free estimate.</p>
      <a href="#book" class="mt-6 inline-flex rounded-full bg-white text-brand-gold hover:bg-gray-100 px-7 py-3.5 font-bold text-sm">Tell us about your project</a>
      <p class="mt-4 text-xs text-white/70">*Subject to credit approval. Terms apply.</p>
    </div>
  </section>

  {/* QUICK ANSWERS */}
  <section class="bg-brand-navy text-white py-14 lg:py-20">
    <div class="mx-auto max-w-3xl px-5">
      <h2 class="text-center font-heading text-2xl sm:text-3xl lg:text-4xl font-bold leading-tight">Quick answers.</h2>
      <ul class="mt-10 divide-y divide-white/10 ring-1 ring-white/10 rounded-2xl bg-brand-dark overflow-hidden list-none p-0">
        {faqs.map((f) => (
          <li>
            <details class="group">
              <summary class="flex items-center justify-between gap-4 px-6 py-5 cursor-pointer list-none">
                <span class="font-heading font-semibold text-base">{f.q}</span>
                <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-brand-gold-light transition-transform group-open:rotate-180 flex-none"><polyline points="6 9 12 15 18 9"/></svg>
              </summary>
              <p class="px-6 pb-5 -mt-1 text-sm text-white/75 leading-relaxed">{f.a}</p>
            </details>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/* FINAL CTA */}
  <section class="bg-black text-white">
    <div class="mx-auto max-w-3xl px-5 py-16 lg:py-24 text-center">
      <h2 class="font-heading text-3xl sm:text-4xl lg:text-5xl font-bold leading-tight">Let's talk about your floors.</h2>
      <a href="#book" class="mt-8 inline-flex rounded-full bg-brand-gold hover:bg-brand-gold-light px-8 py-4 text-base font-bold text-white">Tell us about your project</a>
      <div class="mt-10 flex flex-wrap items-center justify-center gap-x-5 gap-y-2 text-[11px] uppercase tracking-[0.2em] text-white/60 font-semibold">
        <span>WA Licensed &amp; Insured</span><span class="opacity-30">·</span>
        <span>Locally Owned Since {company.founded}</span><span class="opacity-30">·</span>
        <span>Showroom in Vancouver, WA</span>
      </div>
    </div>
  </section>

  {/* Funnel footer + Thorwell stamp — house standard, identical on every client site. Do not restyle. */}
  <footer class="bg-brand-dark border-t border-white/10 py-5 text-xs text-gray-400">
    <div class="max-w-6xl mx-auto px-5 flex flex-col sm:flex-row items-center justify-between gap-5">
      <p class="text-center sm:text-left">&copy; {new Date().getFullYear()} {company.name}. All rights reserved.</p>
      <div class="flex flex-col items-center sm:items-end gap-1.5 leading-none text-center sm:text-right">
        <span class="text-[10px] uppercase tracking-[0.22em] text-white/55 font-semibold">
          Site designed and hosted by
        </span>
        <a
          href="https://thorwellgroup.com"
          target="_blank"
          rel="noopener"
          class="text-lg sm:text-xl tracking-[0.06em] text-white font-normal hover:text-[#CBFBB4] transition-colors no-underline"
        >
          Thor<span class="text-[#CBFBB4]">w</span>ell Group Inc.
        </a>
        <a
          href="https://thorwellgroup.com"
          target="_blank"
          rel="noopener"
          class="text-[10px] sm:text-[11px] tracking-[0.32em] text-white/85 hover:text-[#CBFBB4] transition-colors no-underline"
        >
          The future of flooring
        </a>
      </div>
    </div>
  </footer>

  <!-- LeadConnector form auto-resize script -->
  <script src="https://link.msgsndr.com/js/form_embed.js" is:inline></script>

  <!-- Redirect to the /choose-service/ screening step after the survey is submitted -->
  <script is:inline>
    (function () {
      let redirected = false;
      function go() {
        if (redirected) return;
        redirected = true;
        window.location.href = '/choose-service/';
      }

      // Recursively flatten payload to a searchable string (handles nested objects)
      function flatten(obj, depth) {
        if (depth > 3) return '';
        if (obj == null) return '';
        if (typeof obj === 'string') return obj;
        if (typeof obj === 'number' || typeof obj === 'boolean') return String(obj);
        if (typeof obj !== 'object') return '';
        try {
          return Object.keys(obj).map(k => k + ':' + flatten(obj[k], depth + 1)).join(' ');
        } catch (_) {
          return '';
        }
      }

      function isSurveySuccess(payload) {
        if (!payload) return false;
        const flat = (typeof payload === 'string' ? payload : flatten(payload, 0)).toLowerCase();
        if (!flat) return false;
        // Reject obvious non-success chatter
        if (flat.includes('error') || flat.includes('failed')) return false;
        // Direct event name matches
        if (flat.includes('form-submission-success')) return true;
        if (flat.includes('survey-submission-success')) return true;
        if (flat.includes('form-submitted')) return true;
        if (flat.includes('survey-submitted')) return true;
        if (flat.includes('submission-success')) return true;
        if (flat.includes('submission-completed')) return true;
        // Combined pattern: (form|survey|submission) + (success|submitted|completed)
        if ((flat.includes('survey') || flat.includes('form') || flat.includes('submission')) &&
            (flat.includes('success') || flat.includes('submitted') || flat.includes('completed'))) {
          return true;
        }
        // Payload includes a contactId or submissionId — implies submission persisted
        if (typeof payload === 'object') {
          if (payload.contactId || payload.submissionId) return true;
        }
        return false;
      }

      window.addEventListener('message', function (e) {
        const okOrigin = typeof e.origin === 'string' && (
          e.origin.includes('leadconnectorhq.com') ||
          e.origin.includes('msgsndr.com') ||
          e.origin.includes('gohighlevel.com')
        );
        if (!okOrigin) return;
        if (isSurveySuccess(e.data)) go();
      });
    })();
  </script>

  {/* Weekly openings countdown: counts to next Monday 00:00 in the client's time zone,
      so everyone sees the same clock and it resets every Sunday at midnight. */}
  <script is:inline>
    (function () {
      var root = document.querySelector('[data-countdown]');
      if (!root) return;
      var tz = root.getAttribute('data-tz');
      var cells = {};
      ['d', 'h', 'm', 's'].forEach(function (k) { cells[k] = root.querySelector('[data-cd="' + k + '"]'); });
      var fmt = new Intl.DateTimeFormat('en-US', { timeZone: tz, weekday: 'short', hour: 'numeric', minute: 'numeric', second: 'numeric', hourCycle: 'h23' });
      var DOW = { Mon: 1, Tue: 2, Wed: 3, Thu: 4, Fri: 5, Sat: 6, Sun: 7 };
      function pad(n) { return n < 10 ? '0' + n : String(n); }
      function tick() {
        var p = {};
        fmt.formatToParts(new Date()).forEach(function (x) { p[x.type] = x.value; });
        var intoDay = (+p.hour) * 3600 + (+p.minute) * 60 + (+p.second);
        var left = (8 - DOW[p.weekday]) * 86400 - intoDay;
        cells.d.textContent = pad(Math.floor(left / 86400));
        cells.h.textContent = pad(Math.floor((left % 86400) / 3600));
        cells.m.textContent = pad(Math.floor((left % 3600) / 60));
        cells.s.textContent = pad(left % 60);
      }
      tick();
      setInterval(tick, 1000);
    })();
  </script>
</BaseLayout>

<style>
  .fe-strip-track { animation: fe-marquee 40s linear infinite; width: max-content; }
  @keyframes fe-marquee { from { transform: translateX(0); } to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) { .fe-strip-track { animation: none; } }

  .cd-seg {
    background: rgba(0, 0, 0, 0.45);
    border: 1px solid rgba(204, 0, 0, 0.45);
    border-radius: 12px;
    padding: 0.7rem 0.4rem;
    min-width: 66px;
    display: flex;
    flex-direction: column;
    align-items: center;
    line-height: 1;
  }
  .cd-seg > span { font-size: 2rem; font-weight: 800; font-variant-numeric: tabular-nums; }
  .cd-seg small { margin-top: 0.35rem; font-size: 0.6rem; letter-spacing: 0.18em; text-transform: uppercase; opacity: 0.7; }
  @media (min-width: 720px) {
    .cd-seg { min-width: 88px; padding: 1rem 0.5rem; }
    .cd-seg > span { font-size: 2.75rem; }
  }
</style>
